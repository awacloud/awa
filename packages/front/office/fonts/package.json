{
  "name": "@awacloud/fonts",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Matthieu Bouilloux",
  "company": "AwaCloud SAS",
  "copyright": "Copyright (c) 2026 AwaCloud SAS",
  "type": "module",
  "main": "src/main.js",
  "description": "Browser-safe TrueType / OpenType reader, writer and subsetter — OT v1.9 + TT RM05 hinting, hardened against malformed-font parser attacks. Zero runtime dependency beyond @awacloud/fw.",
  "keywords": [
    "opentype",
    "truetype",
    "sfnt",
    "ttf",
    "otf",
    "woff",
    "woff2",
    "cff",
    "gsub",
    "gpos",
    "variable-fonts",
    "color-fonts",
    "font-subset",
    "embed-pdf",
    "apple-aat",
    "browser"
  ],
  "engines": { "node": ">=18" },
  "sideEffects": false,
  "files": [
    "src/**/*.js",
    "src/**/*.md",
    "!src/**/*.test.js",
    "!src/**/*.test.html",
    "!src/**/_test-runtime.js",
    "dist/**",
    "docs",
    "LICENSE",
    "NOTICE",
    "vendor/NOTICE",
    "vendor/afm/NOTICE-adobe-afm.html",
    "third-party",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./src/main.js",
    "./fonts": "./src/fonts.js",
    "./embed-pdf/subsetForPdf":               "./src/embed-pdf/subsetForPdf.js",
    "./embed-pdf/subsetForPdf/closure":       "./src/embed-pdf/subsetForPdf/closure.js",
    "./embed-pdf/subsetForPdf/cmap-builder":  "./src/embed-pdf/subsetForPdf/cmap-builder.js",
    "./embed-pdf/subsetForPdf/glyph-rewriter":"./src/embed-pdf/subsetForPdf/glyph-rewriter.js",
    "./embed-pdf/subsetForPdf/hash":          "./src/embed-pdf/subsetForPdf/hash.js",
    "./embed-pdf/fontDescriptor":             "./src/embed-pdf/fontDescriptor.js",
    "./embed-pdf/cidSystemInfo":              "./src/embed-pdf/cidSystemInfo.js",
    "./embed-pdf/toUnicodeBuilder":           "./src/embed-pdf/toUnicodeBuilder.js",
    "./embed-pdf/*.js":                       "./src/embed-pdf/*.js",
    "./encodings": "./src/encodings/lookup.js",
    "./standard14": "./src/standard14/lookup.js",
    "./cmap-to-unicode": "./src/cmap/toUnicode.js",
    "./extra/*": "./src/extra/*.js",
    "./bundles/*": "./src/bundles/*.js",
    "./build/*":      { "default": "./dist/build/*" },
    "./standalone/*": { "default": "./dist/standalone/*" }
  },
  "dependencies": {
    "@awacloud/fw": "workspace:*"
  },
  "devDependencies": {
    "@awacloud/tool-fw-codegen": "workspace:*",
    "@awacloud/tool-prebuild-generator": "workspace:*"
  },
  "scripts": {
    "deps:check": "bun ../../../../cli.ts fw-codegen deps --check",
    "gen:bundles": "bun run tools/generate-bundles.mjs",
    "lint": "eslint . --max-warnings 0"
  },
  "awa": { "maturity": "L4", "coverageFloor": 0.87 },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awacloud/awa.git",
    "directory": "packages/front/office/fonts"
  },
  "homepage": "https://awaforge.eu",
  "bugs": {
    "url": "https://github.com/awacloud/awa/issues"
  }
}
