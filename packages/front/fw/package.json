    "./jest/shim": {
      "default": "./integrations/jest/bun-test-shim.js"
    },
    "./next": {
      "types": "./integrations/nextjs/index.d.ts",
      "default": "./integrations/nextjs/index.js"
    },
    "./turbopack": {
      "types": "./integrations/turbopack/index.d.ts",
      "default": "./integrations/turbopack/index.js"
    },
    "./nest": {
      "types": "./integrations/nestjs/index.d.ts",
      "default": "./integrations/nestjs/index.js"
    },
    "./dist/build/*": {
      "default": "./dist/build/*"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "bun test src/",
    "test:watch": "bun test src/ --watch",
    "types": "tsc -p tsconfig.types.json",
    "types:watch": "tsc -p tsconfig.types.json --watch",
    "types:registry": "fw-codegen registry",
    "types:registry:check": "fw-codegen registry --check",
    "types:audit": "fw-codegen audit",
    "integrations:catalog": "fw-bundler catalog",
    "integrations:catalog:check": "fw-bundler catalog --check",
    "prepack": "bun run lint && bun run types && bun run types:registry && bun run prebuild",
    "prebuild": "fw-bundler bundle",
    "prebuild:presets": "fw-bundler bundle presets",
    "prebuild:side-bundles": "fw-bundler bundle side-bundles",
    "prebuild:minimal": "fw-bundler bundle minimal",
    "prebuild:core": "fw-bundler bundle core",
    "prebuild:site": "fw-bundler bundle site",
    "prebuild:site-interactive": "fw-bundler bundle site-interactive",
    "prebuild:spa": "fw-bundler bundle spa",
    "prebuild:pwa": "fw-bundler bundle pwa",
    "prebuild:full": "fw-bundler bundle full",
    "prebuild:sanity": "fw-bundler bundle --sanity-only",
    "prebuild:silent": "fw-bundler bundle --no-log --no-sanity-log",
    "prebuild:esbuild": "fw-bundler bundle --backend esbuild",
    "prebuild:rollup": "fw-bundler bundle --backend rollup",
    "prebuild:node": "node --input-type=module -e \"import('@awacloud/tool-fw-bundler/bundle').then(m => m.runCli(process.argv.slice(1))).then(c => process.exit(c))\" -- --backend esbuild",
    "build:standalone": "fw-bundler standalone",
    "build:parseresult": "bun tools/rendering/precompilation/",
    "build:aot": "bun tools/rendering/aot/",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "setup:e2e": "bun add --no-save esbuild rollup @rollup/plugin-node-resolve @rollup/plugin-terser webpack vite",
    "e2e": "bun integrations/_e2e/run.mjs",
    "e2e:playgrounds": "bun integrations/_e2e/playgrounds.mjs",
    "e2e:preview": "node integrations/_e2e/preview.mjs",
    "e2e:preview:install": "node integrations/_e2e/preview-provision.mjs",
    "setup:vitest": "bun add --no-save vitest",
    "test:vitest": "vitest run -c integrations/vitest/vitest.config.js",
    "setup:jest": "bun add --no-save jest @jest/globals",
    "test:jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js -c integrations/jest/jest.config.mjs",
    "setup:typedoc": "bun add --no-save typedoc",
    "docs:api": "rm -rf dist/types && bun run types && bun integrations/typedoc/categorize.js && typedoc --options integrations/typedoc/typedoc.json"
  },
