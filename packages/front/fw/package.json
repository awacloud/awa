    "./sanity/lockdown": {
      "default": "./src/sanity/lockdown.js"
    },
    "./sanity/lockdown.apply": {
      "default": "./src/sanity/lockdown-apply.js"
    },
    "./config": {
      "default": "./fw.config.json"
    },
    "./vite": {
      "types": "./integrations/vite/index.d.ts",
      "default": "./integrations/vite/index.js"
    },
    "./vite-env": {
      "types": "./integrations/vite/vite-env.d.ts"
    },
    "./esbuild": {
      "types": "./integrations/esbuild/index.d.ts",
      "default": "./integrations/esbuild/index.js"
    },
    "./rollup": {
      "types": "./integrations/rollup/index.d.ts",
      "default": "./integrations/rollup/index.js"
    },
    "./bun": {
      "types": "./integrations/bun/index.d.ts",
      "default": "./integrations/bun/index.js"
    },
    "./webpack": {
      "types": "./integrations/webpack/index.d.ts",
      "default": "./integrations/webpack/index.js"
    },
    "./astro": {
      "types": "./integrations/astro/index.d.ts",
      "default": "./integrations/astro/index.js"
    },
