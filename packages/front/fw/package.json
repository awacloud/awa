{
  "name": "@awacloud/fw",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Zero-dependency browser framework: a DI module runtime with 200+ ESM modules — codecs, compression, crypto (WebCrypto + WASM tiers, post-quantum), DOM rendering and query, workers, security lockdown — usable without a bundler via import maps.",
  "keywords": ["awa", "framework", "browser", "esm", "zero-dependencies", "dependency-injection", "import-maps", "crypto", "webcrypto", "wasm", "post-quantum", "rendering", "service-worker", "web-worker", "lockdown"],
  "engines": { "node": ">=18" },
  "awa": {
    "maturity": "L3",
    "coverageBasis": ["src/**", "integrations/**", "tools/rendering/**", "tools/_lib/cli-help.js"],
    "coverageFloor": 0.92,
    "_coverageComment": "Basis = the package.json files[] JS surface, i.e. exactly what this package PUBLISHES: src/**, integrations/**, tools/rendering/** and tools/_lib/cli-help.js. playground/** is excluded because files[] excludes it (!playground/**), and test files are already out via bunfig coverageSkipTestFiles. The unfiltered All-files aggregate is NOT a source-quality signal here: it is an unweighted mean of per-file %Lines, so it admitted 4 rows that are not this package at all - two tools/fw-bundler/** modules and two OS-temp COPIES that integrations/_shared/config-resolve.test.js imports from a temp dir (1.14% and 29.94%) - which dragged 238 rows to 91.9770% (RED) while the 230 published rows read 93.1865%. The floor stays 0.92, deliberately UNCHANGED: coverageBasis fixes the measurement basis, it must not relax the gate, so the max(0, floor(basis mean) - 2) seeding rule used when DECLARING a floor is not applied here - 0.92 was earned previously and is kept, now with a +1.19 pp margin."
  },
  "main": "src/main.js",
  "types": "dist/types/main.d.ts",
  "sideEffects": [
    "./src/main.js",
    "./src/core/logger.js",
    "./src/sanity/lockdown-apply.js",
    "./dist/build/*.js"
  ],
  "files": [
    "fw.config.json",
    "src/**/*.js",
    "src/**/*.md",
    "src/**/*.bin",
    "types/**/*.d.ts",
    "dist/types/**/*.d.ts",
    "dist/types/**/*.d.ts.map",
    "dist/build/*.min.js",
    "dist/build/*.meta.json",
    "dist/build/**/*.bin",
    "tools/rendering/**/*.js",
    "tools/_lib/cli-help.js",
    "integrations/**/*.js",
    "integrations/**/*.d.ts",
    "integrations/**/*.md",
    "integrations/**/*.json",
    "!tools/**/*.test.js",
    "!tools/**/_fixtures/**",
    "!integrations/_e2e/**",
    "!integrations/**/*.test.js",
    "!src/**/*.test.js",
    "!src/**/*.kat.js",
    "!src/**/*.test.html",
    "!src/**/__fixtures__/**",
    "!dist/types/**/__fixtures__/**",
    "docs",
    "third-party",
    "!docs/api-generated/**",
    "!playground/**",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/main.d.ts",
      "browser": "./src/main.js",
      "import": "./src/main.js",
      "default": "./src/main.js"
    },
    "./core/runtime": {
      "types": "./dist/types/core/runtime.d.ts",
      "default": "./src/core/runtime.js"
    },
    "./core/worker-helper": {
      "types": "./dist/types/core/worker-helper.d.ts",
      "browser": "./src/core/worker-helper.js",
      "default": "./src/core/worker-helper.js"
    },
    "./core/readyState": {
      "types": "./dist/types/core/readyState.d.ts",
      "default": "./src/core/readyState.js"
    },
    "./core/logger": {
      "types": "./dist/types/core/logger.d.ts",
      "default": "./src/core/logger.js"
    },
    "./core/modules": {
      "types": "./dist/types/core/modules.d.ts",
      "default": "./src/core/modules.js"
    },
    "./core/runtime.js": {
      "types": "./dist/types/core/runtime.d.ts",
      "default": "./src/core/runtime.js"
    },
    "./core/worker-helper.js": {
      "types": "./dist/types/core/worker-helper.d.ts",
      "browser": "./src/core/worker-helper.js",
      "default": "./src/core/worker-helper.js"
    },
    "./core/readyState.js": {
      "types": "./dist/types/core/readyState.d.ts",
      "default": "./src/core/readyState.js"
    },
    "./core/logger.js": {
      "types": "./dist/types/core/logger.d.ts",
      "default": "./src/core/logger.js"
    },
    "./core/modules.js": {
      "types": "./dist/types/core/modules.d.ts",
      "default": "./src/core/modules.js"
    },
    "./typed": {
      "types": "./types/typed.d.ts",
      "default": "./src/typed.js"
    },
    "./io/*.js": {
      "types": "./dist/types/io/*.d.ts",
      "default": "./src/io/*.js"
    },
    "./io/*": {
      "types": "./dist/types/io/*.d.ts",
      "default": "./src/io/*"
    },
    "./dom/*.js": {
      "types": "./dist/types/dom/*.d.ts",
      "browser": "./src/dom/*.js",
      "default": "./src/dom/*.js"
    },
    "./dom/*": {
      "types": "./dist/types/dom/*.d.ts",
      "browser": "./src/dom/*",
      "default": "./src/dom/*"
    },
    "./crypto/pkc/__fixtures__/*.js": null,
    "./crypto/pkc/__fixtures__/*": null,
    "./crypto/*.js": {
      "types": "./dist/types/crypto/*.d.ts",
      "default": "./src/crypto/*.js"
    },
    "./crypto/*": {
      "types": "./dist/types/crypto/*.d.ts",
      "default": "./src/crypto/*"
    },
    "./process/*.js": {
      "types": "./dist/types/process/*.d.ts",
      "default": "./src/process/*.js"
    },
    "./process/*": {
      "types": "./dist/types/process/*.d.ts",
      "default": "./src/process/*"
    },
    "./sanity/base": {
      "default": "./src/sanity/base.js"
    },
    "./sanity/base.classic": {
      "default": "./dist/build/sanity-base-classic.min.js"
