{
  "id": "/awa-viewer",
  "name": "AWA Viewer — read your documents on your device",
  "short_name": "AWA Viewer",
  "description": "Open PDF, Word, Excel, PowerPoint, OpenDocument, Markdown and text files in your browser. Nothing is uploaded.",
  "lang": "en",
  "dir": "ltr",
  "scope": "./",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#0f1720",
  "theme_color": "#00263D",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "screenshots": [
    { "src": "screenshots/wide.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "AWA Viewer on a desktop: a Word document drawn as paper pages" },
    { "src": "screenshots/narrow.png", "sizes": "540x960", "type": "image/png", "form_factor": "narrow", "label": "AWA Viewer on a phone: a Word document fitted to the screen" }
  ],
  "launch_handler": { "client_mode": "navigate-new" },
  "file_handlers": [
    {
      "action": "./",
      "launch_type": "multiple-clients",
      "accept": {
        "application/pdf": [".pdf"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"],
        "application/vnd.openxmlformats-officedocument.presentationml.presentation": [".pptx"],
        "application/vnd.oasis.opendocument.text": [".odt"],
        "application/vnd.oasis.opendocument.spreadsheet": [".ods"],
        "application/vnd.oasis.opendocument.presentation": [".odp"],
        "text/markdown": [".md", ".markdown"],
        "text/plain": [".txt", ".log", ".csv"]
      }
    }
  ]
}
