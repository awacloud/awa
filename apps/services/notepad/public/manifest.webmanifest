{
  "id": "/awa-notepad",
  "name": "AWA Notepad — edit your text files on your device",
  "short_name": "AWA Notepad",
  "description": "Write and edit plain-text files in your browser, online or offline. Your files stay on your device.",
  "lang": "en",
  "dir": "ltr",
  "scope": "./",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#0f1720",
  "theme_color": "#00263D",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "screenshots": [
    { "src": "screenshots/wide.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "AWA Notepad on a desktop: a text file open, its encoding and line endings in the status bar" },
    { "src": "screenshots/narrow.png", "sizes": "540x960", "type": "image/png", "form_factor": "narrow", "label": "AWA Notepad on a phone: a text file open" }
  ],
  "launch_handler": { "client_mode": "navigate-new" },
  "file_handlers": [
    {
      "action": "./",
      "launch_type": "multiple-clients",
      "accept": {
        "text/plain": [".txt", ".text", ".log", ".ini", ".cfg", ".conf", ".env", ".csv", ".tsv", ".ts", ".sh", ".ps1", ".bat", ".cmd", ".py", ".sql", ".properties", ".reg", ".srt", ".vtt", ".diff", ".patch"],
        "text/markdown": [".md", ".markdown"],
        "application/json": [".json"],
        "application/xml": [".xml"],
        "text/yaml": [".yml", ".yaml"],
        "application/toml": [".toml"],
        "text/javascript": [".js", ".mjs"],
        "text/css": [".css"],
        "text/html": [".html", ".htm"],
        "image/svg+xml": [".svg"]
      }
    }
  ]
}
